<?xml version="1.0" encoding="utf-8"?>
<!--
    App entering as it is launched from the launcher.

    Kept short and to alpha plus a small scale: this runs on head unit SoCs with
    modest GPUs, where a longer or heavier transition reads as lag rather than
    polish. The scale starts near 1 so the app appears to settle into place
    instead of flying in.
-->
<set xmlns:android="http://schemas.android.com/apk/res/android"
    android:shareInterpolator="false">

    <alpha
        android:duration="200"
        android:fromAlpha="0.0"
        android:interpolator="@android:interpolator/decelerate_quad"
        android:toAlpha="1.0" />

    <scale
        android:duration="220"
        android:fromXScale="0.94"
        android:fromYScale="0.94"
        android:interpolator="@android:interpolator/decelerate_quad"
        android:pivotX="50%p"
        android:pivotY="50%p"
        android:toXScale="1.0"
        android:toYScale="1.0" />
</set>
