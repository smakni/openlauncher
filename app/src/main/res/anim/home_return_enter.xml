<?xml version="1.0" encoding="utf-8"?>
<!--
    Launcher coming back as an app closes.

    The mirror of app_open_exit: the launcher was pushed back and faded, so it
    returns by coming forward again. Playing the opening pair in reverse is what
    makes leaving and returning feel like one gesture rather than two unrelated
    ones.
-->
<set xmlns:android="http://schemas.android.com/apk/res/android"
    android:shareInterpolator="false">

    <alpha
        android:duration="180"
        android:fromAlpha="0.0"
        android:interpolator="@android:interpolator/decelerate_quad"
        android:toAlpha="1.0" />

    <scale
        android:duration="220"
        android:fromXScale="1.04"
        android:fromYScale="1.04"
        android:interpolator="@android:interpolator/decelerate_quad"
        android:pivotX="50%p"
        android:pivotY="50%p"
        android:toXScale="1.0"
        android:toYScale="1.0" />
</set>
